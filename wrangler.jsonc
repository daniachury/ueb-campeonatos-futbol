{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ueb-campeonatos-futbol",
  // Punto de entrada del backend (Worker con Hono).
  "main": "./src/server/index.ts",
  "compatibility_date": "2025-09-01",

  // El frontend (React) se publica como archivos estáticos junto al Worker.
  "assets": {
    // Rutas como /torneos/123 devuelven index.html y React Router decide qué pantalla mostrar.
    "not_found_handling": "single-page-application",
    // Todo lo que empiece por /api la atiende el Worker, incluso si se abre en la barra del navegador.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ueb-campeonatos-db",
      // Reemplazar con el id que imprime `npx wrangler d1 create ueb-campeonatos-db` (ver README).
      // Para desarrollo local este valor no importa.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ueb-campeonatos-futbol",
  // Punto de entrada del backend (Worker con Hono).
  "main": "./src/server/index.ts",
  "compatibility_date": "2025-09-01",
  // URL pública: https://ueb-campeonatos-futbol.dachuryp.workers.dev
  "workers_dev": true,
  "preview_urls": true,

  // El frontend (React) se publica como archivos estáticos junto al Worker.
  "assets": {
    // Rutas como /torneos/123 devuelven index.html y React Router decide qué pantalla mostrar.
    "not_found_handling": "single-page-application",
    // Todo lo que empiece por /api la atiende el Worker, incluso si se abre en la barra del navegador.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ueb-campeonatos-db",
      // Base de producción en la cuenta de Cloudflare del proyecto (`npx wrangler d1 list`).
      // Para desarrollo local este valor no importa: Wrangler usa la copia en .wrangler/.
      "database_id": "deeb4815-fffd-4508-a4d7-23b20ae743df",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  }
}
